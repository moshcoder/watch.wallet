    "@profullstack/redeem-credits": "0.1.0",
    "hono": "^4.8.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.9.0"
  }
}
