    "access": "public"
  },
  "files": ["bin/watchwallet", "src", "public", "README.md", "LICENSE"],
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
