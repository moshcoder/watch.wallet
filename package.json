{
  "name": "@profullstack/watchwallet",
  "version": "0.2.1",
  "description": "watch.wallet: know the second your wallet moves. Watch any address on Bitcoin, Ethereum, Base, Polygon or Solana, or a price, and get an email, a push, or a phone call that wakes you up.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://watch.wallet.pit.world",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moshcoder/watch.wallet.git"
  },
  "bin": {
